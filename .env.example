# =============================================================================
# MASAR AI — environment
# Copy to .env and fill in what you have. EVERY key below is OPTIONAL.
# The system boots with none of them set, logs a structured warning naming the
# degraded capability, and falls back to local Ollama. It never crashes on a
# missing optional key.
# =============================================================================

# ---- Dubai Pulse (legacy API gateway; grants take up to 14 days) ------------
# Not required. Bronze data is recovered from Internet Archive snapshots.
# If these are present, ApiSource layers live refresh on top of the archive.
DUBAI_PULSE_API_KEY=
DUBAI_PULSE_API_SECRET=

# ---- Free-tier LLM providers (no credit card required for any of these) ----
# Groq       → https://console.groq.com/keys      ~30 RPM / 1000 RPD
# Gemini     → https://aistudio.google.com/apikey ~10 RPM / 250 RPD / 1M ctx
# Cerebras   → https://cloud.cerebras.ai          ~1M tokens/day
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=

# ---- Local inference fallback (always available, never rate limited) -------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# ---- Datastores ------------------------------------------------------------
POSTGRES_USER=masar
POSTGRES_PASSWORD=masar_dev_password
POSTGRES_DB=masar
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Read-only role used by the Text-to-SQL agent (A8) — defence in depth
POSTGRES_RO_USER=masar_ro
POSTGRES_RO_PASSWORD=masar_ro_dev_password

REDIS_URL=redis://localhost:6379/0

# ---- GraphRAG (optional; absent Neo4j degrades to a named gap) --------------
# Start it with:  docker compose --profile graph up -d neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=masar_graph_dev_password
# NEO4J_DATABASE=            # leave unset for the default database

# ---- Production deploy (Oracle VM only; see deploy/) ------------------------
# Hostname Caddy provisions TLS for — a free DuckDNS subdomain pointed at the VM.
MASAR_HOSTNAME=
# Oracle Object Storage bucket for nightly pg_dump backups.
MASAR_BACKUP_BUCKET=masar-backups

# ---- Application -----------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000
# Cap on Supervisor re-planning cycles (§5.3 A12)
MAX_REPLAN_CYCLES=3
# Grader sub-score threshold below which evidence is judged insufficient
GRADER_THRESHOLD=0.7

# ---- Tracing (optional; local JSONL tracer is used when unset) -------------
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=masar-ai
LANGSMITH_TRACING=false
